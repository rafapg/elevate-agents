# Padrão offline e reprodutível.
MODEL_PROVIDER=mock

# Ollama local (opt-in):
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=gemma4:26b-mlx
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# OpenRouter (opt-in; mantenha a chave somente no .env local):
# MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_PRIMARY_MODEL=qwen/qwen3.7-plus
# OPENROUTER_BACKUP_MODEL=poolside/laguna-s-2.1:free
# OPENROUTER_REASONING_ENABLED=false  # necessário para tool_choice obrigatório no qwen

# Observabilidade: jsonl | langfuse | both
OBSERVABILITY_BACKEND=jsonl
TRACE_DIR=runs/traces
TRACE_CAPTURE_CONTENT=false

# Langfuse (opt-in)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=lab
# LANGFUSE_RELEASE=
